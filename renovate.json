{
  "extends": [
    "config:recommended",
    "github>canonical/inference-snaps-dev//renovate/default.jsonc#v2"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update upstream llama.cpp vulkan builds",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      // Upstream llama.cpp releases use a single auto-incrementing build number, e.g. b9611.
      // Capture the numeric part from the URL:
      "matchStrings": [
        "https://github\\.com/ggml-org/llama\\.cpp/releases/download/b(?<currentValue>\\d+)/llama-b\\d+-bin-ubuntu-vulkan-\\w+\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ggml-org/llama.cpp",
      // GitHub release tags are prefixed with "b", e.g. b9611.
      // Strip that prefix from datasource results before version comparison.
      "extractVersionTemplate": "^b(?<version>\\d+)$",
      // Compare the captured numeric build number as the minor semantic version: 0.<minor>.0
      "versioningTemplate": "regex:^(?<minor>\\d+)$"
    }
  ]
}
